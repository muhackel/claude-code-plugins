{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "mission_id", "project", "phase", "activity", "revision", "goal",
               "spec", "authorization", "round", "runs", "evaluation", "blocker", "stop_requested", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "mission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "project": {"type": "string", "minLength": 1},
    "phase": {"enum": ["planning", "awaiting_spec", "implementing", "evaluating", "awaiting_acceptance", "completed", "cancelled"]},
    "activity": {"enum": ["idle", "running", "paused", "blocked"]},
    "revision": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 0},
    "spec": {"type": ["object", "null"]},
    "authorization": {"type": ["object", "null"]},
    "evaluation": {"type": ["object", "null"]},
    "blocker": {"type": ["string", "null"]},
    "stop_requested": {"enum": [null, "pause", "cancel"]},
    "runs": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "status", "owner", "child"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["prepared", "running", "succeeded", "failed", "interrupted", "cancelled"]},
          "owner": {"type": ["object", "null"]},
          "child": {"type": ["object", "null"]}
        }
      }
    },
    "events": {"type": "array", "minItems": 1}
  }
}
